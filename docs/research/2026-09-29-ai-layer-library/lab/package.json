{
  "name": "cs-44-ai-layer-lab",
  "private": true,
  "type": "module",
  "description": "The AI SDK against Metis AI for CS-44 (docs/research/2026-09-29-ai-layer-library.md): what each provider puts on the wire, live structured calls, and the re-ask spike",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "wire": "node --experimental-strip-types --no-warnings=ExperimentalWarning wire.ts",
    "live": "node --experimental-strip-types --no-warnings=ExperimentalWarning live.ts",
    "spike": "node --experimental-strip-types --no-warnings=ExperimentalWarning spike.ts",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test reask.test.ts telemetry.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.68",
    "@ai-sdk/deepseek": "3.0.56",
    "@ai-sdk/google": "4.0.85",
    "@ai-sdk/openai": "4.0.81",
    "@ai-sdk/otel": "1.0.122",
    "@ai-sdk/provider": "4.0.19",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace": "2.11.0",
    "ai": "7.0.122",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "5.9.3"
  }
}
