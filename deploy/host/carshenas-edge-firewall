#!/bin/sh
# Docker-published ports bypass ufw, so the web ports are filtered here: port 80 only from ArvanCloud CDN edges
# (carshenas.app is served through the CDN, docs/runbooks/deploy.md "Behind ArvanCloud CDN"), 443 from nobody.
# The ranges are a copy of https://www.arvancloud.ir/fa/ips.txt; update them together with CARSHENAS_TRUSTED_PROXIES.
set -e
RANGES="185.143.232.0/22 188.229.116.16/30 94.101.182.0/27 2.144.3.128/28 37.32.16.0/27 37.32.17.0/27 37.32.18.0/27 37.32.19.0/27 185.215.232.0/22 178.131.120.48/28 94.101.183.0/28 78.157.36.112/28 95.38.61.80/28 193.24.119.0/29"
IF=$(ip route show default | awk "{print \$5; exit}")
iptables -N CARSHENAS-EDGE 2>/dev/null || iptables -F CARSHENAS-EDGE
for r in $RANGES; do iptables -A CARSHENAS-EDGE -s "$r" -p tcp --dport 80 -j RETURN; done
iptables -A CARSHENAS-EDGE -p tcp -m multiport --dports 80,443 -j DROP
iptables -N DOCKER-USER 2>/dev/null || true
iptables -C DOCKER-USER -i "$IF" -j CARSHENAS-EDGE 2>/dev/null || iptables -I DOCKER-USER -i "$IF" -j CARSHENAS-EDGE
