# The images this stack runs that nobody here builds (CS-119). One place for the tags, read by compose.yaml (the server's
# `carshenas` command passes this file to docker compose) and by scripts/deploy.sh, which pulls them on YOUR computer and
# ships them to the server: a server in Iran may not reach Docker Hub, so it never pulls anything.
#
# Bump a tag on purpose, with docs/runbooks/deploy.md ("Update the database or the proxy image"): PostgreSQL 18 with
# pgvector 0.8.6 is the image compose.yaml of the repository runs locally (ADR-0011), so plans and timings measured there
# hold here; no migration creates the vector extension yet, so a plain postgres:18 image would also work today.
POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg18
CADDY_IMAGE=caddy:2.11.6-alpine
