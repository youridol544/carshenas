# The server's settings, every variable and what it is (CS-119, docs/runbooks/deploy.md). On the server this file is `.env`
# in the deployment folder (default ~/carshenas), mode 600, written by `carshenas init-env`, which scripts/deploy.sh runs
# for you the first time. This template is not .env.example because agents may not read .env.* files; like example.env
# it holds no real value, and a real .env never goes into the repository, an image, a chat or a log.
#
# A value is a single line without spaces unless it is quoted. Passwords and keys use letters and digits only (the
# generated ones do): the database passwords are written into connection strings.

# ---- Where the site answers: the proxy (deploy/Caddyfile) ------------------------------------------------------------
# The domain visitors type, or the server's own address when you have no domain yet.
CARSHENAS_SITE_ADDRESS=demo.example.ir
# auto: a domain whose DNS points here, certificate from Let's Encrypt (ports 80 and 443 open to the internet).
# manual: a domain, with certs/fullchain.pem and certs/privkey.pem you put on the server.
# internal: an address and no domain, a certificate Caddy signs itself (browsers warn once).
# acme-ip: an address and no domain, a six-day Let's Encrypt certificate for the address itself (experimental).
CARSHENAS_TLS_MODE=auto
# Let's Encrypt writes to it about the account: an address you read. Needed in auto mode only.
ACME_EMAIL=you@example.com

# ---- Visibility (ADR-0017 point 10) -------------------------------------------------------------------------------------
# 1 (the default): every response says noindex, robots.txt disallows everything, the link is shared only through the
# submission. 0 lists the site. Read by the web app and by the proxy; change it, then `carshenas up`.
CARSHENAS_UNLISTED=1

# ---- Secrets: generated on the server by `carshenas init-env`, never typed, never copied elsewhere --------------------
POSTGRES_PASSWORD=generated
CARSHENAS_MIGRATE_PASSWORD=generated
CARSHENAS_WEB_PASSWORD=generated
CARSHENAS_READONLY_PASSWORD=generated
CARSHENAS_WORKER_PASSWORD=generated
CARSHENAS_ADMIN_PASSWORD=generated
# At least 32 random bytes in base64: keys the sign-in throttle's hashes and signs device cookies (docs/runbooks/accounts.md).
CARSHENAS_AUTH_KEY=generated

# ---- What you give it ---------------------------------------------------------------------------------------------------
# How the crawler names itself to every source, with a contact address (ADR-0008 point 5). Quoted: it has spaces.
CRAWLER_USER_AGENT="CarshenasBot/0.1 (+contact: you@example.com)"
# The one key to every language model (ADR-0019), from console.metisai.ir/api-keys. The worker stops at start without one;
# nothing is spent unless a switch below is on.
METIS_API_KEY=

# ---- Model spending switches: off unless you turn them on (credit is for work a person starts) -----------------------------
# 1: the worker reads listing texts with a model every five minutes, up to US$10 a Tehran day (docs/runbooks/worker.md).
EXTRACTION_SCHEDULED=0
# 1: the search box may ask a model about a sentence code cannot settle, within the cap and the limits below.
SEARCH_UNDERSTANDING_AI=0
# SEARCH_UNDERSTANDING_DAILY_CAP_USD=1
# SEARCH_UNDERSTANDING_VISITOR_LIMIT=40
# SEARCH_UNDERSTANDING_CONCURRENCY=4

# ---- Optional ------------------------------------------------------------------------------------------------------------
# LOG_LEVEL=info                        trace, debug, info, warn, error, fatal or silent (docs/runbooks/logs-and-errors.md)
# CARSHENAS_SIGN_IN_ADDRESS_LIMIT=100   failed sign-ins one address may make in an hour
# CARSHENAS_SIGN_UP_ADDRESS_LIMIT=20    sign-ups per address and hour
# CARSHENAS_USERNAME_CHECK_ADDRESS_LIMIT=120
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318   send traces to a collector you run (docs/runbooks/logs-and-errors.md)
# WEB_MEMORY=1g  WEB_HEAP_MB=768        memory limit of the web container, and Node's heap inside it
# WORKER_MEMORY=1g  WORKER_HEAP_MB=768  the same for the worker

# ---- Backups and releases (docs/runbooks/deploy.md, "Backups and releases") ------------------------------------------------
# The nightly backup runs at this Tehran time and keeps this many nights; named releases are never deleted by it.
BACKUP_AT=01:30
BACKUP_KEEP=14
# Where releases are kept: outside the repository, on the server. A folder on another disk is safer than the same one.
# RELEASES_DIR=/srv/carshenas/releases

# ---- Written by `carshenas init-env`, from the person who owns the server's folder -----------------------------------------
# Who the backup container runs as, so the releases it writes belong to you.
DEPLOY_UID=1000
DEPLOY_GID=1000
