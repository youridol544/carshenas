# Copy to e2e/.env (gitignored). All values are optional.

# Where tests/app points. Unset = a production build of apps/web started on http://127.0.0.1:3100
# E2E_BASE_URL=http://127.0.0.1:3000   # e.g. an already running `pnpm dev`

# Command that starts the app under test; Playwright waits for E2E_BASE_URL to answer.
# Set E2E_BASE_URL alone to test an already running app or a deployed preview.
# E2E_WEB_SERVER_CMD=pnpm --dir ../apps/web exec next dev --port 3100

# Run only the harness self-tests against the fixture site (no application build).
# E2E_ONLY_FIXTURE=1
# E2E_WEB_SERVER_CWD=..

# Include @visual screenshot comparisons (baselines come from the Playwright container only).
# E2E_VISUAL=1

# Add an iPhone/WebKit project (needs: pnpm exec playwright install webkit, plus system deps).
# E2E_WEBKIT=1
