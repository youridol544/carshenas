{
  "name": "@carshenas/observability",
  "version": "0.0.0",
  "private": true,
  "description": "Structured logs, error serialisation and reporting, and trace correlation for the Carshenas web app and workers (ADR-0016). TypeScript source, run as is by Next.js and by Node.",
  "type": "module",
  "exports": {
    "./browser": "./src/browser.ts",
    "./capture": "./src/capture.ts",
    "./console": "./src/console.ts",
    "./context": "./src/context.ts",
    "./errors": "./src/errors.ts",
    "./logger": "./src/logger.ts",
    "./process": "./src/process.ts",
    "./redact": "./src/redact.ts",
    "./tracing": "./src/tracing.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9",
    "typescript": "catalog:",
    "typescript-eslint": "8.70.0"
  }
}
