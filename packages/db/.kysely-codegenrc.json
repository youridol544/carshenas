{
  "dialect": "postgres",
  "url": "env(DATABASE_MIGRATE_URL)",
  "outFile": "src/db-types.ts",
  "includePattern": "public.*",
  "typeMapping": {
    "int8": "number"
  },
  "overrides": {
    "columns": {
      "account.id": "ColumnType<number, never, never>",
      "account.role": "Generated<'buyer' | 'superadmin'>",
      "account_role_change.from_role": "'buyer' | 'superadmin' | null",
      "account_role_change.id": "ColumnType<number, never, never>",
      "account_role_change.to_role": "'buyer' | 'superadmin'",
      "account_session.id": "ColumnType<number, never, never>",
      "auth_throttle.id": "ColumnType<number, never, never>",
      "auth_throttle.scope": "'sign_in_account' | 'sign_in_device' | 'sign_in_address' | 'sign_up_address' | 'username_check_address'",
      "crawl_lane.cooldown_reason": "'unavailable' | 'rate_limited' | null",
      "crawl_run.id": "ColumnType<number, never, never>",
      "crawl_run.kind": "'discovery' | 'detail' | 'measure'",
      "crawl_run.status": "Generated<'running' | 'succeeded' | 'failed' | 'stopped_on_block'>",
      "fetch_log.id": "ColumnType<number, never, never>",
      "fetch_log.method": "Generated<'http_get' | 'http_post' | 'official_api'>",
      "fetch_log.outcome": "'ok' | 'not_modified' | 'not_found' | 'gone' | 'blocked' | 'rate_limited' | 'challenge' | 'error'",
      "listing.id": "ColumnType<number, never, never>",
      "listing.origin": "Generated<'external' | 'native'>",
      "listing.status": "'active' | 'sold' | 'expired' | 'gone' | 'removed'",
      "listing_price_event.id": "ColumnType<number, never, never>",
      "listing_price_event.last_asking_price_toman": "ColumnType<number | null, never, never>",
      "listing_price_event.previous_price_toman": "ColumnType<number | null, never, never>",
      "listing_price_event.previous_price_type": "ColumnType<'asking' | 'negotiable' | 'installment' | 'placeholder' | null, never, never>",
      "listing_price_event.price_type": "'asking' | 'negotiable' | 'installment' | 'placeholder'",
      "listing_status_transition.origin": "'external' | 'native'",
      "model_volume.id": "ColumnType<number, never, never>",
      "model_volume.level": "'all' | 'brand' | 'model' | 'trim'",
      "snapshot.content_sha256": "ColumnType<Buffer, never, never>",
      "snapshot.id": "ColumnType<number, never, never>",
      "source.access_method": "'crawl' | 'official_api' | 'native'",
      "source.crawl_state": "Generated<'enabled' | 'paused' | 'stopped_on_block'>",
      "source.listing_visibility": "'public' | 'requester_only'",
      "source.origin": "'external' | 'native' | 'benchmark'",
      "source.stop_reason": "'blocked' | 'rate_limited' | 'challenge' | null",
      "source_policy_check.id": "ColumnType<number, never, never>",
      "source_policy_check.verdict": "'allowed' | 'allowed_with_conditions' | 'not_allowed'",
      "source_state_change.cleared_stop_reason": "'blocked' | 'rate_limited' | 'challenge' | null",
      "source_state_change.from_state": "'enabled' | 'paused' | 'stopped_on_block'",
      "source_state_change.id": "ColumnType<number, never, never>",
      "source_state_change.to_state": "'enabled' | 'paused'"
    }
  }
}
