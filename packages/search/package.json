{
  "name": "@carshenas/search",
  "version": "0.0.0",
  "private": true,
  "description": "Search filters, sorts and catalogues as declarative definitions (CS-58, ADR-0027): each filter's value schema, Farsi label, description, chip text, URL parameter and predicate; one Search schema with one URL and one JSON serialisation, shared by the search API, the search and home pages, search files and plain-Farsi search; and the server side that turns a Search into SQL over listing_filter_row. TypeScript source, run as is by Next.js, in the browser and by Node; and the search table CS-59 builds from that view (document.ts), the keyset cursor of a results page (cursor.ts) and the freshness window (freshness.ts).",
  "type": "module",
  "exports": {
    "./catalogues": "./src/catalogues.ts",
    "./cursor": "./src/cursor.ts",
    "./describe": "./src/describe.ts",
    "./document": "./src/document.ts",
    "./explain": "./src/explain.ts",
    "./filters": "./src/filters.ts",
    "./freshness": "./src/freshness.ts",
    "./kinds": "./src/kinds.ts",
    "./options-queries": "./src/options-queries.ts",
    "./search": "./src/search.ts",
    "./sorts": "./src/sorts.ts",
    "./sql": "./src/sql.ts",
    "./understand/claims": "./src/understand/claims.ts",
    "./understand/code-pass": "./src/understand/code-pass.ts",
    "./understand/fillers": "./src/understand/fillers.ts",
    "./understand/fixture": "./src/understand/fixture.ts",
    "./understand/intents": "./src/understand/intents.ts",
    "./understand/lexicon": "./src/understand/lexicon.ts",
    "./understand/lexicon-queries": "./src/understand/lexicon-queries.ts",
    "./understand/merge": "./src/understand/merge.ts",
    "./understand/model-input": "./src/understand/model-input.ts",
    "./understand/phrases": "./src/understand/phrases.ts",
    "./understand/quantities": "./src/understand/quantities.ts",
    "./understand/reading": "./src/understand/reading.ts",
    "./understand/numbers": "./src/understand/numbers.ts",
    "./understand/text": "./src/understand/text.ts",
    "./understand/types": "./src/understand/types.ts",
    "./understand/understand": "./src/understand/understand.ts",
    "./year": "./src/year.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC node --experimental-strip-types --no-warnings=ExperimentalWarning --test $(find src -name '*.test.ts' | sort)",
    "test:db": "NODE_ENV=test TZ=UTC node --env-file-if-exists=../../.env --experimental-strip-types --no-warnings=ExperimentalWarning --test --test-concurrency=1 $(find test -name '*.db.test.ts' | sort)"
  },
  "dependencies": {
    "@carshenas/db": "workspace:*",
    "@carshenas/locale": "workspace:*",
    "kysely": "0.29.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9",
    "typescript": "catalog:",
    "typescript-eslint": "8.70.0"
  }
}
