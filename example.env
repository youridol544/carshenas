# Local development settings. scripts/init.sh copies this file to .env when .env is missing; .env is gitignored and
# unreadable to agents. (This template is not named .env.example because agents may not read .env.* files, and
# they must be able to keep it current.) These passwords protect a container published on 127.0.0.1 only;
# production values come from the server's environment and secret store, never from a file in the repository.

# The local PostgreSQL container (compose.yaml)
POSTGRES_PORT=5418
POSTGRES_PASSWORD=local-superuser
CARSHENAS_MIGRATE_PASSWORD=local-migrate
CARSHENAS_WEB_PASSWORD=local-web
CARSHENAS_READONLY_PASSWORD=local-readonly
CARSHENAS_WORKER_PASSWORD=local-worker

# One connection string per role (db/bootstrap/10-roles.sql)
DATABASE_URL=postgres://carshenas_web:local-web@127.0.0.1:5418/carshenas
DATABASE_MIGRATE_URL=postgres://carshenas_migrate:local-migrate@127.0.0.1:5418/carshenas?sslmode=disable
DATABASE_READONLY_URL=postgres://carshenas_readonly:local-readonly@127.0.0.1:5418/carshenas
WORKER_DATABASE_URL=postgres://carshenas_worker:local-worker@127.0.0.1:5418/carshenas

# Logging and error reporting (docs/runbooks/logs-and-errors.md, ADR-0016). All optional; the defaults suit
# development. LOG_LEVEL: trace, debug, info, warn, error, fatal or silent. LOG_FORMAT: pretty or json.
# CARSHENAS_LOG_SQL=1 logs every SQL statement at debug level (parameters in development only).
# CARSHENAS_DIAGNOSTICS=1 opens the routes that fail on purpose. OTEL_EXPORTER_OTLP_ENDPOINT sends traces to an
# OpenTelemetry collector.
# LOG_LEVEL=debug
# LOG_FORMAT=pretty
# CARSHENAS_LOG_SQL=1
# CARSHENAS_DIAGNOSTICS=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# The worker (apps/worker, docs/runbooks/worker.md). WORKER_HEALTH_PORT is the loopback port of its GET /health
# (3101 by default). CRAWLER_USER_AGENT is how the crawler names itself to every source, with a contact address
# (ADR-0008 point 5); required once a job sends a request.
# WORKER_HEALTH_PORT=3101
# CRAWLER_USER_AGENT=CarshenasBot/0.1 (+contact: you@example.com)
