# Local development settings. scripts/init.sh copies this file to .env when .env is missing; .env is gitignored and
# unreadable to agents. (This template is not named .env.example because agents may not read .env.* files, and
# they must be able to keep it current.) These passwords protect a container published on 127.0.0.1 only;
# production values come from the server's environment and secret store, never from a file in the repository.

# The local PostgreSQL container (compose.yaml)
POSTGRES_PORT=5418
POSTGRES_PASSWORD=local-superuser
CARSHENAS_MIGRATE_PASSWORD=local-migrate
CARSHENAS_WEB_PASSWORD=local-web
CARSHENAS_READONLY_PASSWORD=local-readonly
CARSHENAS_WORKER_PASSWORD=local-worker
CARSHENAS_ADMIN_PASSWORD=local-admin

# One connection string per role (db/bootstrap/10-roles.sql). ADMIN_DATABASE_URL is the superadmin section's own role
# (ADR-0023), used by the web app's admin pages alone.
DATABASE_URL=postgres://carshenas_web:local-web@127.0.0.1:5418/carshenas
DATABASE_MIGRATE_URL=postgres://carshenas_migrate:local-migrate@127.0.0.1:5418/carshenas?sslmode=disable
DATABASE_READONLY_URL=postgres://carshenas_readonly:local-readonly@127.0.0.1:5418/carshenas
WORKER_DATABASE_URL=postgres://carshenas_worker:local-worker@127.0.0.1:5418/carshenas
ADMIN_DATABASE_URL=postgres://carshenas_admin:local-admin@127.0.0.1:5418/carshenas

# Logging and error reporting (docs/runbooks/logs-and-errors.md, ADR-0016). All optional; the defaults suit
# development. LOG_LEVEL: trace, debug, info, warn, error, fatal or silent. LOG_FORMAT: pretty or json.
# CARSHENAS_LOG_SQL=1 logs every SQL statement at debug level (parameters in development only).
# CARSHENAS_DIAGNOSTICS=1 opens the routes that fail on purpose. OTEL_EXPORTER_OTLP_ENDPOINT sends traces to an
# OpenTelemetry collector.
# LOG_LEVEL=debug
# LOG_FORMAT=pretty
# CARSHENAS_LOG_SQL=1
# CARSHENAS_DIAGNOSTICS=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# CARSHENAS_ENVIRONMENT names a deployment on every log line (production, staging; NODE_ENV when unset) and CARSHENAS_RELEASE
# the build (the commit when unset). OTEL_EXPORTER_OTLP_TRACES_ENDPOINT overrides the endpoint for traces alone;
# OTEL_SDK_DISABLED=true switches tracing off whatever the endpoints say.
# CARSHENAS_ENVIRONMENT=production
# CARSHENAS_RELEASE=2026-10-04
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_SDK_DISABLED=true

# The worker (apps/worker, docs/runbooks/worker.md). WORKER_HEALTH_PORT is the loopback port of its GET /health
# (3101 by default). CRAWLER_USER_AGENT is how the crawler names itself to every source, with a contact address
# (ADR-0008 point 5); required once a job sends a request.
# WORKER_HEALTH_PORT=3101
# CRAWLER_USER_AGENT=CarshenasBot/0.1 (+contact: you@example.com)

# Language models (ADR-0019): Metis AI serves every provider through one key, created at console.metisai.ir/api-keys.
# Keep it here or in the server's secret store only: never commit, log or paste it.
# METIS_API_KEY=tpsg-...
# Plain-Farsi search (CS-62, docs/specs/S04-plain-farsi-search.md). The search box understands a sentence with code
# alone by default: no key, no network, no cost. SEARCH_UNDERSTANDING_AI=1 lets a model read what code cannot settle,
# within a daily cap per Tehran day (default US$1), a per-address hourly limit (default 40 questions) and the answer
# cache. Credit on the Metis account is for work a person starts, so no file in the repository turns this on: set it
# in the server's environment when you mean to spend.
# SEARCH_UNDERSTANDING_AI=1
# SEARCH_UNDERSTANDING_DAILY_CAP_USD=1
# SEARCH_UNDERSTANDING_VISITOR_LIMIT=40
# SEARCH_UNDERSTANDING_CONCURRENCY=4
# The worker reads listing texts with a model every five minutes (extraction.read, CS-52) only when this is 1; it is off
# by default so Metis credit is spent on tasks, not on a schedule (the job's own daily cap is US$10).
# EXTRACTION_SCHEDULED=1

# Accounts (ADR-0020, docs/runbooks/accounts.md). CARSHENAS_AUTH_KEY keys the sign-in throttle's hashes and signs
# device cookies: at least 32 random bytes in base64 (openssl rand -base64 32). This value is for local development
# only; every deployment sets its own and keeps it with its other secrets. The address limits count per client
# address and hour (defaults 100 failed sign-ins, 20 sign-ups, 120 username checks); the browser tests raise them,
# since every test signs in from 127.0.0.1.
CARSHENAS_AUTH_KEY=bG9jYWwtZGV2ZWxvcG1lbnQtb25seS1hdXRoLWtleS0zMmI=
# CARSHENAS_SIGN_IN_ADDRESS_LIMIT=100
# CARSHENAS_SIGN_UP_ADDRESS_LIMIT=20
# CARSHENAS_USERNAME_CHECK_ADDRESS_LIMIT=120
